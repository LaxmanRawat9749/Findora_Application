<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════════
         Findora — Dark Material3 Application Theme
         ═══════════════════════════════════════════════════════════════ -->
    <style name="Theme.Findora" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/light_purple</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>

        <item name="colorSecondary">@color/success_green</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/light_green</item>
        <item name="colorOnSecondaryContainer">@color/success_green</item>

        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/md_theme_onError</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/screen_background</item>
        <item name="colorSurface">@color/surface_01</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorSurfaceVariant">@color/card_background</item>
        <item name="colorOnSurfaceVariant">@color/text_gray</item>
        <item name="colorOutline">@color/md_theme_outline</item>

        <!-- Status bar — light, dark icons -->
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:navigationBarColor">@color/surface_01</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>

        <!-- Seamless window animation (eliminates black screen flash during theme switch) -->
        <item name="android:windowAnimationStyle">@style/Animation.Findora.ThemeSwitch</item>

        <!-- Global Component Styles -->
        <item name="materialButtonStyle">@style/Widget.Findora.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Findora.Card</item>
        <item name="textInputStyle">@style/Widget.Findora.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.Findora.Chip</item>
        <item name="bottomNavigationStyle">@style/Widget.Findora.BottomNav</item>
    </style>

    <!-- ─── Seamless Theme Switching Animation Style ────────────────── -->
    <style name="Animation.Findora.ThemeSwitch" parent="@android:style/Animation.Activity">
        <item name="android:windowEnterAnimation">@anim/no_anim</item>
        <item name="android:windowExitAnimation">@anim/no_anim</item>
        <item name="android:windowShowAnimation">@anim/no_anim</item>
        <item name="android:windowHideAnimation">@anim/no_anim</item>
        <item name="android:activityOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:activityOpenExitAnimation">@anim/no_anim</item>
        <item name="android:activityCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:activityCloseExitAnimation">@anim/no_anim</item>
        <item name="android:taskOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:taskOpenExitAnimation">@anim/no_anim</item>
        <item name="android:taskCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:taskCloseExitAnimation">@anim/no_anim</item>
        <item name="android:taskToFrontEnterAnimation">@anim/no_anim</item>
        <item name="android:taskToFrontExitAnimation">@anim/no_anim</item>
        <item name="android:taskToBackEnterAnimation">@anim/no_anim</item>
        <item name="android:taskToBackExitAnimation">@anim/no_anim</item>
        <item name="android:wallpaperOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:wallpaperOpenExitAnimation">@anim/no_anim</item>
        <item name="android:wallpaperCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:wallpaperCloseExitAnimation">@anim/no_anim</item>
        <item name="android:wallpaperIntraOpenEnterAnimation">@anim/no_anim</item>
        <item name="android:wallpaperIntraOpenExitAnimation">@anim/no_anim</item>
        <item name="android:wallpaperIntraCloseEnterAnimation">@anim/no_anim</item>
        <item name="android:wallpaperIntraCloseExitAnimation">@anim/no_anim</item>
    </style>

    <!-- ─── Primary Button ──────────────────────────────────────────── -->
    <style name="Widget.Findora.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@color/primary_purple</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- ─── Outlined Button ─────────────────────────────────────────── -->
    <style name="Widget.Findora.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="strokeColor">@color/primary_purple</item>
        <item name="android:textColor">@color/primary_purple</item>
    </style>

    <!-- ─── Text Button ──────────────────────────────────────────────── -->
    <style name="Widget.Findora.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/primary_purple</item>
    </style>

    <!-- ─── Card ─────────────────────────────────────────────────────── -->
    <style name="Widget.Findora.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="rippleColor">@color/primary_purple_10</item>
    </style>

    <!-- ─── Surface Card (slightly lighter) ──────────────────────────── -->
    <style name="Widget.Findora.Card.Surface" parent="Widget.Findora.Card">
        <item name="cardBackgroundColor">@color/surface_02</item>
    </style>

    <!-- ─── TextInputLayout ──────────────────────────────────────────── -->
    <style name="Widget.Findora.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="boxStrokeColor">@color/md_theme_outline</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/primary_purple</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="boxBackgroundColor">@color/surface_02</item>
        <item name="endIconTint">@color/text_gray</item>
        <item name="startIconTint">@color/text_gray</item>
    </style>

    <!-- ─── Filter Chip ──────────────────────────────────────────────── -->
    <style name="Widget.Findora.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/chip_corner_radius</item>
        <item name="chipBackgroundColor">@color/chip_bg_colors</item>
        <item name="chipStrokeColor">@color/chip_stroke_colors</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text_colors</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ─── Bottom Navigation ────────────────────────────────────────── -->
    <style name="Widget.Findora.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/nav_item_colors</item>
        <item name="itemTextColor">@color/nav_item_colors</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Findora.BottomNav.ActiveIndicator</item>
    </style>

    <style name="Widget.Findora.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/light_purple</item>
    </style>

    <!-- ─── Toolbar ──────────────────────────────────────────────────── -->
    <style name="Widget.Findora.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/screen_background</item>
        <item name="titleTextColor">@color/text_dark</item>
        <item name="navigationIconTint">@color/text_dark</item>
    </style>

    <style name="Theme.Findora.Splash" parent="Theme.Findora">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#534AB7</item>
        <item name="android:statusBarColor">#534AB7</item>
        <item name="android:navigationBarColor">#534AB7</item>
    </style>

</resources>