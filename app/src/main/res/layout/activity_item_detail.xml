<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/screen_background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/text_dark"
            app:title="Item Details"
            app:titleTextColor="@color/text_dark" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/spacing_xlarge">

            <!-- Main Info Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Findora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Images ViewPager -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vp_images"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="@color/light_purple"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_large">

                        <!-- Type + Category -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_featured_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_badge_featured"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="⭐ FEATURED"
                                android:textColor="@color/primary_purple"
                                android:textSize="@dimen/text_caption"
                                android:fontFamily="sans-serif-medium"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_type_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_lost"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="LOST"
                                android:textColor="@color/error_red"
                                android:textSize="@dimen/text_caption"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tv_category"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_small"
                                android:text="Wallet"
                                android:textColor="@color/text_gray"
                                android:textSize="@dimen/text_caption"
                                android:fontFamily="sans-serif-medium" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tv_returned_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_found"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="✓ RETURNED"
                                android:textColor="@color/success_green"
                                android:textSize="@dimen/text_caption"
                                android:fontFamily="sans-serif-medium"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- Title -->
                        <TextView
                            android:id="@+id/tv_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:text="Item Title"
                            android:textColor="@color/text_dark"
                            android:textSize="@dimen/text_h2"
                            android:fontFamily="sans-serif-black" />

                        <!-- Reward -->
                        <TextView
                            android:id="@+id/tv_reward"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Reward: Rs. 0"
                            android:textColor="@color/primary_purple"
                            android:textSize="@dimen/text_body"
                            android:fontFamily="sans-serif-medium"
                            android:visibility="gone" />

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="@dimen/spacing_medium"
                            android:background="@color/divider" />

                        <!-- Reporter -->
                        <LinearLayout
                            android:id="@+id/layout_reporter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            android:paddingVertical="4dp">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cv_reporter_avatar"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginEnd="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/iv_reporter_avatar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_person" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tv_reporter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reported by Unknown"
                                android:textColor="@color/text_gray"
                                android:textSize="@dimen/text_caption"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <!-- Location -->
                        <LinearLayout
                            android:id="@+id/layout_location"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_search"
                                app:tint="@color/text_hint" />

                            <TextView
                                android:id="@+id/tv_location"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="Location unknown"
                                android:textColor="@color/text_gray"
                                android:textSize="@dimen/text_caption" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_view_map"
                                style="@style/Widget.Findora.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View Map" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Description Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Findora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textColor="@color/text_dark"
                        android:textSize="@dimen/text_body"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="4dp"
                        android:text="Detailed description..."
                        android:textColor="@color/text_gray"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons for Owner -->
            <LinearLayout
                android:id="@+id/layout_owner_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_promote"
                    style="@style/Widget.Findora.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="⭐ Promote This Item" />
            </LinearLayout>

            <!-- Action Buttons for Lost Items / Default -->
            <LinearLayout
                android:id="@+id/layout_default_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_chat"
                    style="@style/Widget.Findora.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:text="Chat" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_return_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mark_returned"
                    style="@style/Widget.Findora.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="Mark as Returned"
                    android:visibility="gone"
                    app:backgroundTint="@color/primary_purple" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_confirm_return"
                    style="@style/Widget.Findora.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="Confirm Return"
                    android:visibility="gone"
                    app:backgroundTint="@color/success_green" />
            </LinearLayout>

            <!-- Rating Section for Owner when item is resolved -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_rate_finder"
                style="@style/Widget.Findora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/warning_orange"
                app:cardBackgroundColor="@color/card_background"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐"
                            android:textSize="24sp"
                            android:layout_marginEnd="8dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_rate_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rate the Finder"
                                android:textColor="@color/text_dark"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-bold" />

                            <TextView
                                android:id="@+id/tv_rate_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reward your finder with positive reputation"
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_rate_finder"
                            style="@style/Widget.Findora.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Rate ⭐"
                            android:textSize="12sp"
                            app:backgroundTint="@color/warning_orange" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons for Found Items -->
            <LinearLayout
                android:id="@+id/layout_found_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_contact_finder"
                    style="@style/Widget.Findora.Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:text="Contact Finder"
                    app:backgroundTint="@color/primary_purple" />

                <Space
                    android:layout_width="@dimen/spacing_medium"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_conversations"
                    style="@style/Widget.Findora.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:text="View Conversations" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary_purple"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>