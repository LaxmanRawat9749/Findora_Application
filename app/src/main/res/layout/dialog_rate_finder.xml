<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/card_background">

    <!-- Header Icon -->
    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_star"
        app:tint="@color/warning_orange"
        android:contentDescription="Rate Finder" />

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Rate the Finder"
        android:textColor="@color/text_dark"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black" />

    <TextView
        android:id="@+id/tvDialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="How was your experience getting your item returned?"
        android:textColor="@color/text_gray"
        android:textSize="13sp" />

    <!-- Interactive Star Rating Bar -->
    <LinearLayout
        android:id="@+id/layoutStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivStar1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="4dp"
            android:src="@android:drawable/star_big_off"
            app:tint="@color/text_disabled" />

        <ImageView
            android:id="@+id/ivStar2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="4dp"
            android:src="@android:drawable/star_big_off"
            app:tint="@color/text_disabled" />

        <ImageView
            android:id="@+id/ivStar3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="4dp"
            android:src="@android:drawable/star_big_off"
            app:tint="@color/text_disabled" />

        <ImageView
            android:id="@+id/ivStar4"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="4dp"
            android:src="@android:drawable/star_big_off"
            app:tint="@color/text_disabled" />

        <ImageView
            android:id="@+id/ivStar5"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="4dp"
            android:src="@android:drawable/star_big_off"
            app:tint="@color/text_disabled" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRatingHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Tap a star to rate"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Optional Written Review -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Findora.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Leave a review (optional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:lines="3"
            android:gravity="top"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_hint" />
    </com.google.android.material.textfield.TextInputLayout>

    <ProgressBar
        android:id="@+id/pbRatingLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:indeterminateTint="@color/primary_purple" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelRating"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textColor="@color/text_gray"
            app:strokeColor="@color/card_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitRating"
            style="@style/Widget.Findora.Button"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="@dimen/button_height"
            android:text="Submit Rating"
            app:backgroundTint="@color/primary_purple" />
    </LinearLayout>

</LinearLayout>
