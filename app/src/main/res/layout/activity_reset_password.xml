<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/screen_background"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/text_dark"
        app:title="Reset Password"
        app:titleTextColor="@color/text_dark" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/spacing_large"
            android:paddingBottom="@dimen/spacing_xlarge">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create New Password"
                android:textColor="@color/text_dark"
                android:textSize="@dimen/text_h2"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/tvEmailSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_large"
                android:gravity="center"
                android:text="Enter the 6-digit OTP code and your new password."
                android:textColor="@color/text_gray"
                android:textSize="@dimen/text_caption" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Findora.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_small"
                        android:text="OTP Code"
                        android:textColor="@color/text_gray"
                        android:textSize="@dimen/text_caption"
                        android:fontFamily="sans-serif-medium" />

                    <!-- OTP Container: Single Hidden EditText + 6 Dummy TextViews -->
                    <FrameLayout
                        android:id="@+id/otpContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal">

                        <!-- The 6 visual boxes -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:weightSum="6">

                            <TextView android:id="@+id/tvOtp1" android:layout_width="0dp" android:layout_height="@dimen/otp_box_size" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:maxWidth="@dimen/otp_box_size" android:background="@drawable/bg_otp_box_dark" android:gravity="center" android:textColor="@color/text_dark" android:textSize="20sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:id="@+id/tvOtp2" android:layout_width="0dp" android:layout_height="@dimen/otp_box_size" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:maxWidth="@dimen/otp_box_size" android:background="@drawable/bg_otp_box_dark" android:gravity="center" android:textColor="@color/text_dark" android:textSize="20sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:id="@+id/tvOtp3" android:layout_width="0dp" android:layout_height="@dimen/otp_box_size" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:maxWidth="@dimen/otp_box_size" android:background="@drawable/bg_otp_box_dark" android:gravity="center" android:textColor="@color/text_dark" android:textSize="20sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:id="@+id/tvOtp4" android:layout_width="0dp" android:layout_height="@dimen/otp_box_size" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:maxWidth="@dimen/otp_box_size" android:background="@drawable/bg_otp_box_dark" android:gravity="center" android:textColor="@color/text_dark" android:textSize="20sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:id="@+id/tvOtp5" android:layout_width="0dp" android:layout_height="@dimen/otp_box_size" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:maxWidth="@dimen/otp_box_size" android:background="@drawable/bg_otp_box_dark" android:gravity="center" android:textColor="@color/text_dark" android:textSize="20sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:id="@+id/tvOtp6" android:layout_width="0dp" android:layout_height="@dimen/otp_box_size" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:maxWidth="@dimen/otp_box_size" android:background="@drawable/bg_otp_box_dark" android:gravity="center" android:textColor="@color/text_dark" android:textSize="20sp" android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <!-- The actual invisible input field overlaying the boxes -->
                        <EditText
                            android:id="@+id/etHiddenOtp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:cursorVisible="false"
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:digits="0123456789"
                            android:maxLength="6"
                            android:importantForAutofill="yes"
                            android:autofillHints="smsOTPCode"
                            android:textColor="@android:color/transparent"
                            android:textIsSelectable="false"
                            android:longClickable="true" />
                    </FrameLayout>

                    <!-- New Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Findora.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:hint="New Password"
                        app:passwordToggleEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/text_hint"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvStrength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="4dp"
                        android:text="Strength: Weak"
                        android:textColor="@color/error_red"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone" />

                    <!-- Confirm Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Findora.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:hint="Confirm New Password"
                        app:passwordToggleEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/text_hint"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:gravity="center"
                        android:textColor="@color/error_red"
                        android:textSize="@dimen/text_caption"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:indeterminateTint="@color/primary_purple"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetPassword"
                        style="@style/Widget.Findora.Button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:text="Reset Password" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>